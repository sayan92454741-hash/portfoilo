                { name: "PHP / MySQL", icon: "fa-brands fa-php", level: "80%" },
                { name: "WooCommerce", icon: "fa-solid fa-cart-shopping", level: "90%" },
                { name: "Git & GitHub", icon: "fa-brands fa-git-alt", level: "85%" }
            ],

            projects: [
                {
                    title: "প্রি-মিয়াম ই-কমার্স সলিউশন",
                    category: "WordPress & WooCommerce",
                    image: "https://images.unsplash.com/photo-1556742049-0a67d553c2a3?auto=format&fit=crop&w=800&q=80",
                    liveUrl: "#",
                    githubUrl: "https://github.com/sayan92454741-hash"
                },
                {
                    title: "ਕਾਰপরোরেট বিজনেস ওয়েবসাইট",
                    category: "Elementor Pro",
                    image: "https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=800&q=80",
                    liveUrl: "#",
                    githubUrl: "https://github.com/sayan92454741-hash"
                },
                {
                    title: "মডার্ন পোর্টফোলিও ল্যান্ডিং পেজ",
                    category: "HTML / Tailwind CSS",
                    image: "https://images.unsplash.com/photo-1507238691740-187a5b1d37b8?auto=format&fit=crop&w=800&q=80",
                    liveUrl: "#",
                    githubUrl: "https://github.com/sayan92454741-hash"
                }
            ],

            // Telegram & Google Sheet Integration API (Optional placeholders)
            telegramBotToken: "YOUR_TELEGRAM_BOT_TOKEN",
            telegramChatId: "YOUR_CHAT_ID",
            googleScriptApi: "YOUR_GOOGLE_SCRIPT_WEB_APP_URL",
            
            // Google Map Embed Link
            googleMapLink: "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14723.365445214066!2d88.3756!3d22.6710!2m3!1f0!2f0!3f0!3m2!1f1024!2f768!4f13.1!3m3!1m2!1s0x39f89e52df5ef7f7%3A0x6b8bc7e8d75cf78e!2sBelghoria%2C%2sKolkata%2C%2sWest%20Bengal!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
        };

        // ==========================================
        // DYNAMIC DATA INJECTION SCRIPT
        // ==========================================
        document.getElementById('hero-name').innerText = CONFIG.name;
        document.getElementById('hero-bio').innerText = CONFIG.bio;
        document.getElementById('profile-img').src = CONFIG.profileImg;
        document.getElementById('about-details').innerText = CONFIG.aboutDetails;
        document.getElementById('contact-location').innerText = CONFIG.location;
        document.getElementById('contact-phone').innerText = CONFIG.phone;
        document.getElementById('contact-email').innerText = CONFIG.email;
        document.getElementById('footer-name').innerText = CONFIG.name;
        document.getElementById('google-map').src = CONFIG.googleMapLink;

        // Render Top Menu Social Icons (Left Side)
        const navSocialContainer = document.getElementById('nav-social-icons');
        CONFIG.socialLinks.forEach(link => {
            navSocialContainer.innerHTML += `<a href="${link.url}" target="_blank" class="text-gray-300 hover:text-primary transition-colors text-lg"><i class="${link.icon}"></i></a>`;
        });

        // Render Experiences
        const expContainer = document.getElementById('experience-container');
        CONFIG.experiences.forEach(exp => {
            expContainer.innerHTML += `
                <div class="glass-card p-6 rounded-2xl border border-white/5 space-y-2">
                    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-primary/20 text-primary">${exp.year}</span>
                    <h4 class="text-xl font-semibold text-white pt-2">${exp.title}</h4>
                    <p class="text-primary text-sm">${exp.company}</p>
                    <p class="text-gray-400 text-sm">${exp.desc}</p>
                </div>
            `;
        });

        // Render Skills
        const skillsGrid = document.getElementById('skills-grid');
        CONFIG.skills.forEach(skill => {
            skillsGrid.innerHTML += `
                <div class="glass-card p-5 rounded-2xl flex items-center space-x-4 border border-white/5 hover:border-primary/50 transition-all">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary text-xl">
                        <i class="${skill.icon}"></i>
                    </div>
                    <div>
                        <h4 class="font-medium text-white">${skill.name}</h4>
                        <span class="text-xs text-primary font-semibold">${skill.level}</span>
                    </div>
                </div>
            `;
        });

        // Render Projects
        const projectsGrid = document.getElementById('projects-grid');
        CONFIG.projects.forEach(project => {
            projectsGrid.innerHTML += `
                <div class="glass-card rounded-2xl overflow-hidden border border-white/10 group" data-aos="fade-up">
                    <div class="project-img-container">
                        <img src="${project.image}" alt="${project.title}">
                    </div>
                    <div class="p-6 space-y-4">
                        <span class="text-xs font-semibold px-3 py-1 rounded-full bg-primary/20 text-primary">${project.category}</span>
                        <h3 class="text-xl font-semibold text-white group-hover:text-primary transition-colors">${project.title}</h3>
                        <div class="flex items-center justify-between pt-2">
                            <a href="${project.liveUrl}" target="_blank" class="px-4 py-2 rounded-xl bg-primary text-white text-sm font-medium flex items-center gap-1.5 hover:bg-primary/80 transition-all">
                                <i class="fa-solid fa-eye"></i> Live Preview
                            </a>
                            <a href="${project.githubUrl}" target="_blank" class="px-4 py-2 rounded-xl glass-card text-white text-sm font-medium flex items-center gap-1.5 hover:border-primary transition-all">
                                <i class="fa-brands fa-github"></i> GitHub
                            </a>
                        </div>
                    </div>
                </div>
            `;
        });

        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
        document.querySelectorAll('.mobile-link').forEach(link => {
            link.addEventListener('click', () => mobileMenu.classList.add('hidden'));
        });

        // Form Submission Logic (Telegram & Google Sheet / Local Simulation)
        const contactForm = document.getElementById('contact-form');
        const formStatus = document.getElementById('form-status');

        contactForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const submitBtn = document.getElementById('submit-btn');
            submitBtn.disabled = true;
            submitBtn.innerText = "পাঠানো হচ্ছে...";

            const formData = {
                name: document.getElementById('name').value,
                phone: document.getElementById('phone').value,
                email: document.getElementById('email').value,
                message: document.getElementById('message').value
            };

            try {
                // Telegram Notification Trigger (যদি কনফিগার করা থাকে)
                if(CONFIG.telegramBotToken !== "YOUR_TELEGRAM_BOT_TOKEN") {
                    const text = `New Portfolio Contact:\nName: ${formData.name}\nPhone: ${formData.phone}\nEmail: ${formData.email}\nMessage: ${formData.message}`;
                    await fetch(`https://api.telegram.org/bot${CONFIG.telegramBotToken}/sendMessage`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ chat_id: CONFIG.telegramChatId, text: text })
                    });
                }

                // Google Script API Trigger (যদি কনফিগার করা থাকে)
                if(CONFIG.googleScriptApi !== "YOUR_GOOGLE_SCRIPT_WEB_APP_URL") {
                    await fetch(CONFIG.googleScriptApi, {
                        method: 'POST',
                        mode: 'no-cors',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(formData)
                    });
                }

                formStatus.classList.remove('hidden', 'text-red-500');
                formStatus.classList.add('text-green-400');
                formStatus.innerText = "ধন্যবাদ! আপনার বার্তা সফলভাবে পাঠানো হয়েছে।";
                contactForm.reset();
            } catch (error) {
                formStatus.classList.remove('hidden', 'text-green-400');
                formStatus.classList.add('text-red-500');
                formStatus.innerText = "দুঃখিত, কোনো সমস্যা হয়েছে। আবার চেষ্টা করুন।";
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerText = "মেসেজ পাঠান";
            }
        });
    </script>
</body>
</html>
